# ==============================================================================
# UNIQ CRACKERS — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# DO NOT PUT REAL SECRETS IN THIS FILE. COPY TO .env.local FOR LOCAL DEVELOPMENT.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="Uniq Crackers"
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000

# ------------------------------------------------------------------------------
# 2. SUPABASE CONFIGURATION (Database & Storage)
# ------------------------------------------------------------------------------
# Find these in your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
# Service role key is STRICTLY FOR SERVER ROUTES. Never expose in frontend!
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Optional direct Postgres URLs (Dashboard -> Project Settings -> Database -> Connection string)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY SECRETS
# ------------------------------------------------------------------------------
# Generate strong 64-char random strings in production (e.g., openssl rand -base64 32)
JWT_SECRET="replace-with-ultra-secure-random-jwt-secret-min-32-chars"
JWT_EXPIRES_IN="7d"
ADMIN_SESSION_SECRET="replace-with-ultra-secure-admin-session-secret"
ADMIN_PASSWORD="replace-with-secure-admin-password"
ADMIN_WHATSAPP_PHONE="replace-with-admin-mobile-10-digits"
ADMIN_PHONE="replace-with-admin-mobile-10-digits"
COOKIE_DOMAIN=""
COOKIE_SECURE="false" # Set to true in production (HTTPS)

# ------------------------------------------------------------------------------
# 4. STORE & GEOLOCATION CONFIGURATION (Default: Velmala, Hyderabad Center)
# ------------------------------------------------------------------------------
# F6GQ+7PW, Velmala, Hyderabad, Telangana 502300 (Approx: 17.502900, 78.257300)
NEXT_PUBLIC_STORE_LAT=17.502900
NEXT_PUBLIC_STORE_LNG=78.257300
NEXT_PUBLIC_DEFAULT_DELIVERY_RADIUS_KM=7.0
NEXT_PUBLIC_STORE_ADDRESS="F6GQ+7PW, Velmala, Hyderabad, Telangana 502300"
NEXT_PUBLIC_STORE_PHONE="+919000000000"

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAY (Razorpay & Direct UPI)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder_key"
RAZORPAY_KEY_SECRET="replace-with-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="replace-with-razorpay-webhook-secret"

# Direct UPI Merchant VPA & Name (Prepaid Orders Deep Link & QR Verification)
MERCHANT_UPI_ID="tejareddysheri72-3@okaxis"
NEXT_PUBLIC_MERCHANT_UPI_ID="tejareddysheri72-3@okaxis"
MERCHANT_UPI_NAME="Teja Reddy Sheri"
NEXT_PUBLIC_MERCHANT_UPI_NAME="Teja Reddy Sheri"

# ------------------------------------------------------------------------------
# 6. NOTIFICATION CHANNELS (WhatsApp for Ops, SMS for Customer OTP)
# ------------------------------------------------------------------------------
# WhatsApp Cloud API / Provider (For Admin + Delivery Agent Ops Only)
WHATSAPP_API_URL="https://graph.facebook.com/v19.0"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
ADMIN_ALERT_WHATSAPP_NUMBERS="+919876543210,+919876543211"

# SMS OTP Provider (Fast2SMS / Twilio / MSG91)
FAST2SMS_API_KEY=""
SMS_GATEWAY_API_KEY=""
SMS_GATEWAY_SENDER_ID="UNIQCR"

# ------------------------------------------------------------------------------
# 7. REALTIME & GPS WEBSOCKET / SSE CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_REALTIME_WS_URL="ws://localhost:3000/api/realtime"
GPS_LOCATION_UPDATE_INTERVAL_SECONDS=5

# ------------------------------------------------------------------------------
# 8. RATE LIMITING & CACHE (Redis / In-Memory)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
